# "anthropic" (paid, best quality/citations) or "ollama" (free, local, no API key)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-8

# Only used when LLM_PROVIDER=ollama. Install: `brew install ollama && ollama pull llama3.1:8b`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Multilingual model - knowledge base and queries are in Russian.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

TOP_K_VECTOR=8
TOP_K_BM25=8
TOP_K_FINAL=5
RRF_K=60
MIN_RELEVANCE_SCORE=0.48
