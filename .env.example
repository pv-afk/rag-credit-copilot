# "anthropic" — Claude API (платно, нужен ключ) или "ollama" — локальная модель (бесплатно, без ключа)
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-8

# Используется только при LLM_PROVIDER=ollama. Установка: brew install ollama && ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Мультиязычная модель: база знаний и вопросы на русском.
# При смене модели пересоберите индекс и заново подберите MIN_RELEVANCE_SCORE.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

CHUNK_SIZE_WORDS=220
CHUNK_OVERLAP_WORDS=40

TOP_K_VECTOR=8
TOP_K_BM25=8
TOP_K_FINAL=5
RRF_K=60
MIN_RELEVANCE_SCORE=0.48
